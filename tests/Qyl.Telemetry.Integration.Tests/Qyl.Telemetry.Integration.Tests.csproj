<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <!-- These cases exercise the platform's instrumentation and raw producer representations,
         including qyl-owned namespaces used by instrumentation fixtures. -->
    <OtelSemConvInstrumentationLibrary>true</OtelSemConvInstrumentationLibrary>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../eng/build/build.csproj" />
    <ProjectReference Include="../../src/Qyl.Telemetry.Hosting/Qyl.Telemetry.Hosting.csproj" />
    <PackageReference Include="Qyl.Telemetry.Testing" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>
</Project>
