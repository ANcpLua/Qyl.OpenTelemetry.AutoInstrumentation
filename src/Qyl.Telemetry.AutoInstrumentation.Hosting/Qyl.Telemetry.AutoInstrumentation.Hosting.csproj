<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.Telemetry.AutoInstrumentation.Hosting</RootNamespace>
    <AssemblyName>Qyl.Telemetry.AutoInstrumentation.Hosting</AssemblyName>
    <PackageId>Qyl.Telemetry.AutoInstrumentation.Hosting</PackageId>
    <Description>Native AOT bootstrap for qyl diagnostic listeners, activated by a generated module initializer. Use Qyl.Telemetry.Hosting and AddQyl() to configure telemetry export.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\Qyl.Telemetry.AutoInstrumentation.Hosting.targets"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Qyl.Telemetry.AutoInstrumentation.Hosting.Bootstrap.g.cs"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qyl.Telemetry.AutoInstrumentation\Qyl.Telemetry.AutoInstrumentation.csproj"
                      IncludeAssets="all"
                      PrivateAssets="none" />
    <ProjectReference Include="..\Qyl.Telemetry.AutoInstrumentation.DiagnosticListeners\Qyl.Telemetry.AutoInstrumentation.DiagnosticListeners.csproj" />
  </ItemGroup>

</Project>
