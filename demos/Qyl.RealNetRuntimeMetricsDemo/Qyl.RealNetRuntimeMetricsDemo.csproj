<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.RealNetRuntimeMetricsDemo</RootNamespace>
    <AssemblyName>Qyl.RealNetRuntimeMetricsDemo</AssemblyName>
    <Description>Real OpenTelemetry runtime metric proof for qyl.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Qyl.Telemetry.AutoInstrumentation\Qyl.Telemetry.AutoInstrumentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OTLP pipeline the Demos lane asserts through the collector; QYL_ENDPOINT names it. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <Compile Include="..\Shared\QylDemoOtlp.cs" Link="QylDemoOtlp.cs" />
  </ItemGroup>

</Project>
