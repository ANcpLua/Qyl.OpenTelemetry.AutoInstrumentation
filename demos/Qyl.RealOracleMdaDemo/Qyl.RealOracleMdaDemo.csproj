<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.RealOracleMdaDemo</RootNamespace>
    <AssemblyName>Qyl.RealOracleMdaDemo</AssemblyName>
    <Description>Real zero-code ODP.NET native ActivitySource ("Oracle.ManagedDataAccess.Core") proof for qyl, including the attribute delta the vendor's OpenTelemetry add-on enriches with.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <!-- Enrichment only: the spans arrive without it. The demo registers it in one lane to
         measure exactly which attributes it adds. -->
    <PackageReference Include="Oracle.ManagedDataAccess.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Qyl.Telemetry.Hosting\Qyl.Telemetry.Hosting.csproj" />
  </ItemGroup>

</Project>
