<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.RealGraphQlDemo</RootNamespace>
    <AssemblyName>Qyl.RealGraphQlDemo</AssemblyName>
    <Description>Real zero-code GraphQL.NET native ActivitySource proof for qyl.</Description>
    <!-- GraphQL 8.x is not AOT-safe (IL2104/IL3053); its NativeAOT image makes the linux-arm64
         `objcopy` only-keep-debug symbol-extraction step exit 1. The demo only needs to run to
         prove the library's own source fires, not ship stripped binaries, so skip the separate
         debug-symbol extraction on AOT publish. Keeps symbols inline; no objcopy call. -->
    <StripSymbols Condition="'$(PublishAot)' == 'true'">false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" />
    <PackageReference Include="GraphQL.MicrosoftDI" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Qyl.Telemetry.Hosting\Qyl.Telemetry.Hosting.csproj" />
  </ItemGroup>

</Project>
